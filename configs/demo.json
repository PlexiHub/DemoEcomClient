    "activity-logs",
    "users",
    "developer",
    "tools",
    "tools.messages",
    "tools.assets",
    "tools.bulk-image-resize",
    "tools.meta-catalog",
    "logs",
    "system-logs",
    "trash",
    "settings"
  ],
